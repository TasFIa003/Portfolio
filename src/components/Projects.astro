---
import { projects } from '../data/projects';

const langColors: Record<string, string> = {
  'EJS / Node.js': 'bg-[#FDF3DC] dark:bg-yellow-900/20 text-[#8B6914] dark:text-yellow-300',
  'Java':          'bg-orange-50 dark:bg-orange-900/20 text-orange-800 dark:text-orange-300',
  'Python':        'bg-sky-50 dark:bg-sky-900/20 text-sky-800 dark:text-sky-300',
  'R':             'bg-sage-100 dark:bg-sage-900/20 text-sage-700 dark:text-sage-300',
};
---

<section id="projects" class="py-24 px-4 sm:px-6 lg:px-8" aria-labelledby="projects-heading">
  <div class="max-w-6xl mx-auto">
    <div class="mb-12">
      <p class="text-sm font-semibold tracking-widest uppercase text-golden-600 dark:text-golden-400 mb-3" data-animate>
        GitHub
      </p>
      <h2
        id="projects-heading"
        class="section-heading text-3xl sm:text-4xl text-[#2C1A0F] dark:text-[#F0EBD8]"
        data-animate data-animate-delay="100"
      >
        Projects
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 gap-6">
      {projects.map((project, i) => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col p-6 rounded-2xl border border-[#DFD0B5] dark:border-[#3D3020] bg-[#FEFAE0] dark:bg-[#251E14] hover:border-golden-400 dark:hover:border-golden-700 hover:shadow-md transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-golden-500 focus:ring-offset-2"
          data-animate
          data-animate-delay={String(Math.min((i + 1) * 100, 400))}
          aria-label={`${project.name} on GitHub`}
        >
          <div class="flex items-start justify-between mb-3">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#B8A080] dark:text-[#5A4530] group-hover:text-golden-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
              </svg>
              <h3 class="font-semibold text-[#2C1A0F] dark:text-[#F0EBD8] group-hover:text-golden-600 dark:group-hover:text-golden-400 transition-colors">
                {project.name}
              </h3>
            </div>
            {project.pinned && (
              <span class="shrink-0 text-xs font-medium px-2 py-0.5 rounded-full bg-[#F0E8D5] dark:bg-[#2F2519] text-[#9A7A60] dark:text-[#C0A87A]">
                Pinned
              </span>
            )}
          </div>

          <p class="text-sm text-[#7A5E48] dark:text-[#C0A87A] leading-relaxed flex-1 mb-4">
            {project.description}
          </p>

          <div class="flex items-center justify-between mt-auto">
            <div class="flex flex-wrap gap-1.5">
              <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${langColors[project.language] ?? 'bg-[#F0E8D5] dark:bg-[#2F2519] text-[#7A5E48] dark:text-[#C0A87A]'}`}>
                {project.language}
              </span>
              {project.tags?.filter(t => !project.language.includes(t)).map(tag => (
                <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-[#F0E8D5] dark:bg-[#2F2519] text-[#9A7A60] dark:text-[#C0A87A]">
                  {tag}
                </span>
              ))}
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#B8A080] dark:text-[#5A4530] group-hover:text-golden-500 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-8 text-center" data-animate data-animate-delay="400">
      <a
        href="https://github.com/TasFIa003"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-medium text-golden-600 dark:text-golden-400 hover:underline"
      >
        View all repositories on GitHub
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
