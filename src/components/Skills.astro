---
import { skillGroups } from '../data/skills';
---

<section
  id="skills"
  class="py-24 px-4 sm:px-6 lg:px-8 bg-[#FAEDCD] dark:bg-[#1F1912]"
  aria-labelledby="skills-heading"
>
  <div class="max-w-6xl mx-auto">
    <div class="mb-12">
      <p class="text-sm font-semibold tracking-widest uppercase text-golden-600 dark:text-golden-400 mb-3" data-animate>
        Expertise
      </p>
      <h2
        id="skills-heading"
        class="section-heading text-3xl sm:text-4xl text-[#2C1A0F] dark:text-[#F0EBD8]"
        data-animate data-animate-delay="100"
      >
        Skills & Tools
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {skillGroups.map((group, i) => (
        <div
          class="p-6 rounded-2xl border border-[#DFD0B5] dark:border-[#3D3020] bg-[#FEFAE0] dark:bg-[#251E14]"
          data-animate
          data-animate-delay={String(Math.min((i + 1) * 100, 400))}
        >
          <div class="flex items-center gap-3 mb-5">
            <div class="w-9 h-9 rounded-lg bg-golden-50 dark:bg-golden-950/30 flex items-center justify-center text-golden-600 dark:text-golden-400 shrink-0" aria-hidden="true">
              {group.icon === 'code' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                </svg>
              )}
              {group.icon === 'dna' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
                </svg>
              )}
              {group.icon === 'molecule' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"/>
                </svg>
              )}
              {group.icon === 'brain' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2h-2"/>
                </svg>
              )}
            </div>
            <h3 class="font-semibold text-[#2C1A0F] dark:text-[#F0EBD8]">{group.category}</h3>
          </div>

          <div class="flex flex-wrap gap-2">
            {group.skills.map(skill => (
              <span class="px-3 py-1.5 rounded-lg text-sm font-medium bg-[#F5EDD8] dark:bg-[#2F2519] text-[#4A3020] dark:text-[#D8C8A8] border border-[#DFD0B5] dark:border-[#3D3020] hover:border-golden-300 dark:hover:border-golden-700 hover:bg-golden-50 dark:hover:bg-golden-950/20 transition-colors cursor-default">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
