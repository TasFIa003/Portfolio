---
import { education } from '../data/education';

const activities = [
  {
    title: 'Project Showcasing (Software)',
    event: 'CSE Fest',
    organization: 'RUET',
    date: 'Jun 2022',
  },
  {
    title: 'Participant',
    event: 'bdapps National Hackathon 2022',
    organization: 'Rajshahi University',
    date: 'Aug 2022',
  },
];
---

<section id="education" class="py-24 px-4 sm:px-6 lg:px-8" aria-labelledby="education-heading">
  <div class="max-w-4xl mx-auto">

    <!-- Education -->
    <div class="mb-16">
      <p class="text-sm font-semibold tracking-widest uppercase text-golden-600 dark:text-golden-400 mb-3" data-animate>
        Academic Background
      </p>
      <h2
        id="education-heading"
        class="section-heading text-3xl sm:text-4xl text-[#2C1A0F] dark:text-[#F0EBD8] mb-10"
        data-animate data-animate-delay="100"
      >
        Education
      </h2>

      <div class="relative">
        <div class="absolute left-5 top-0 bottom-0 w-px bg-[#DFD0B5] dark:bg-[#3D3020] hidden sm:block" aria-hidden="true"></div>
        <div class="space-y-8">
          {education.map((edu, i) => (
            <div class="relative sm:pl-16" data-animate data-animate-delay={String(i * 150)}>
              <div class="absolute left-0 top-1 hidden sm:flex w-10 h-10 rounded-full bg-golden-500 items-center justify-center shadow-sm" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M12 14l9-5-9-5-9 5 9 5z"/><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
                </svg>
              </div>

              <div class="p-6 rounded-2xl border border-[#DFD0B5] dark:border-[#3D3020] bg-[#FEFAE0] dark:bg-[#251E14] hover:border-golden-400 dark:hover:border-golden-700 hover:shadow-md transition-all duration-300">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h3 class="font-semibold text-[#2C1A0F] dark:text-[#F0EBD8] text-lg">{edu.degree}</h3>
                    <p class="text-golden-600 dark:text-golden-400 font-medium text-sm mt-0.5">{edu.institution}</p>
                    <p class="text-[#9A7A60] dark:text-[#7A6248] text-xs mt-0.5">{edu.location}</p>
                  </div>
                  <div class="text-right shrink-0">
                    <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-golden-50 dark:bg-golden-950/30 text-golden-700 dark:text-golden-300 border border-golden-200 dark:border-golden-800/40">
                      <span class="text-xs font-medium">GPA</span>
                      <span class="font-bold text-sm">{edu.grade}<span class="text-xs font-normal opacity-70">/{edu.gradeScale}</span></span>
                    </div>
                    <p class="text-xs text-[#9A7A60] dark:text-[#7A6248] mt-1">{edu.startDate} – {edu.endDate}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Activities & Honors -->
    <div id="activities">
      <p class="text-sm font-semibold tracking-widest uppercase text-golden-600 dark:text-golden-400 mb-3" data-animate>
        Honors & Activities
      </p>
      <h2
        class="section-heading text-3xl sm:text-4xl text-[#2C1A0F] dark:text-[#F0EBD8] mb-8"
        data-animate data-animate-delay="100"
      >
        Activities
      </h2>

      <div class="grid sm:grid-cols-2 gap-4">
        {activities.map((act, i) => (
          <div
            class="p-5 rounded-xl border border-[#DFD0B5] dark:border-[#3D3020] bg-[#FEFAE0] dark:bg-[#251E14] hover:border-golden-400 dark:hover:border-golden-700 transition-all duration-200"
            data-animate
            data-animate-delay={String(i * 100)}
          >
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-golden-50 dark:bg-golden-950/30 flex items-center justify-center text-golden-600 dark:text-golden-400 shrink-0 mt-0.5" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-[#2C1A0F] dark:text-[#F0EBD8] text-sm">{act.title}</p>
                <p class="text-sm text-golden-600 dark:text-golden-400 mt-0.5">{act.event}</p>
                <p class="text-xs text-[#9A7A60] dark:text-[#7A6248] mt-0.5">{act.organization} · {act.date}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
