---
import SocialIcon from './icons/SocialIcon.astro';
---

<section
  id="contact"
  class="py-24 px-4 sm:px-6 lg:px-8 bg-[#FAEDCD] dark:bg-[#1F1912]"
  aria-labelledby="contact-heading"
>
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold tracking-widest uppercase text-golden-600 dark:text-golden-400 mb-3" data-animate>
        Get in Touch
      </p>
      <h2
        id="contact-heading"
        class="section-heading text-3xl sm:text-4xl text-[#2C1A0F] dark:text-[#F0EBD8] mb-4"
        data-animate data-animate-delay="100"
      >
        Contact
      </h2>
      <p class="max-w-xl mx-auto text-[#7A5E48] dark:text-[#C0A87A] leading-relaxed" data-animate data-animate-delay="200">
        I am actively seeking PhD opportunities in Computational Biology and Bioinformatics.
        If you are a PI or admissions coordinator interested in my work, please reach out — I would be glad to share my full CV and research statement.
      </p>
    </div>

    <div class="grid sm:grid-cols-3 gap-5 mb-10" data-animate data-animate-delay="300">
      <!-- Email -->
      <a
        href="mailto:tasfianoor.cse.ruet@gmail.com"
        class="group flex flex-col items-center p-6 rounded-2xl border border-[#DFD0B5] dark:border-[#3D3020] bg-[#FEFAE0] dark:bg-[#251E14] hover:border-golden-400 dark:hover:border-golden-700 hover:shadow-md transition-all duration-300 text-center focus:outline-none focus:ring-2 focus:ring-golden-500 focus:ring-offset-2"
      >
        <div class="w-12 h-12 rounded-xl bg-golden-50 dark:bg-golden-950/30 flex items-center justify-center text-golden-600 dark:text-golden-400 mb-3 group-hover:bg-golden-100 dark:group-hover:bg-golden-950/50 transition-colors" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <span class="text-xs font-semibold tracking-wide uppercase text-[#B8A080] dark:text-[#5A4530] mb-1">Email</span>
        <span class="text-sm font-medium text-[#4A3020] dark:text-[#D8C8A8] group-hover:text-golden-600 dark:group-hover:text-golden-400 transition-colors break-all">tasfianoor.cse.ruet@gmail.com</span>
      </a>

      <!-- Phone -->
      <a
        href="tel:+8801706794170"
        class="group flex flex-col items-center p-6 rounded-2xl border border-[#DFD0B5] dark:border-[#3D3020] bg-[#FEFAE0] dark:bg-[#251E14] hover:border-golden-400 dark:hover:border-golden-700 hover:shadow-md transition-all duration-300 text-center focus:outline-none focus:ring-2 focus:ring-golden-500 focus:ring-offset-2"
      >
        <div class="w-12 h-12 rounded-xl bg-golden-50 dark:bg-golden-950/30 flex items-center justify-center text-golden-600 dark:text-golden-400 mb-3 group-hover:bg-golden-100 dark:group-hover:bg-golden-950/50 transition-colors" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
        </div>
        <span class="text-xs font-semibold tracking-wide uppercase text-[#B8A080] dark:text-[#5A4530] mb-1">Phone</span>
        <span class="text-sm font-medium text-[#4A3020] dark:text-[#D8C8A8] group-hover:text-golden-600 dark:group-hover:text-golden-400 transition-colors">+880 1706 794170</span>
      </a>

      <!-- Location -->
      <div class="flex flex-col items-center p-6 rounded-2xl border border-[#DFD0B5] dark:border-[#3D3020] bg-[#FEFAE0] dark:bg-[#251E14] text-center">
        <div class="w-12 h-12 rounded-xl bg-golden-50 dark:bg-golden-950/30 flex items-center justify-center text-golden-600 dark:text-golden-400 mb-3" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <span class="text-xs font-semibold tracking-wide uppercase text-[#B8A080] dark:text-[#5A4530] mb-1">Location</span>
        <span class="text-sm font-medium text-[#4A3020] dark:text-[#D8C8A8]">Rajshahi, Bangladesh</span>
      </div>
    </div>

    <!-- Social links + CV download -->
    <div class="flex flex-wrap justify-center items-center gap-4" data-animate data-animate-delay="400">
      <!-- GitHub — simple-icons siGithub -->
      <a
        href="https://github.com/TasFIa003"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="flex items-center gap-2 px-4 py-2 rounded-lg border border-[#DFD0B5] dark:border-[#3D3020] text-sm font-medium text-[#7A5E48] dark:text-[#C0A87A] hover:border-golden-300 dark:hover:border-golden-700 hover:bg-[#F5EDD8] dark:hover:bg-[#2F2519] transition-colors"
      >
        <SocialIcon name="github" class="w-4 h-4" />
        GitHub
      </a>

      <!-- LinkedIn — official LinkedIn brand asset -->
      <a
        href="https://www.linkedin.com/in/tasfia-noor-8491661b3/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="flex items-center gap-2 px-4 py-2 rounded-lg border border-[#DFD0B5] dark:border-[#3D3020] text-sm font-medium text-[#7A5E48] dark:text-[#C0A87A] hover:border-golden-300 dark:hover:border-golden-700 hover:bg-[#F5EDD8] dark:hover:bg-[#2F2519] transition-colors"
      >
        <SocialIcon name="linkedin" class="w-4 h-4" />
        LinkedIn
      </a>

      <!-- ResearchGate — simple-icons siResearchgate (official path) -->
      <a
        href="https://www.researchgate.net/profile/Tasfia-Noor"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ResearchGate"
        class="flex items-center gap-2 px-4 py-2 rounded-lg border border-[#DFD0B5] dark:border-[#3D3020] text-sm font-medium text-[#7A5E48] dark:text-[#C0A87A] hover:border-golden-300 dark:hover:border-golden-700 hover:bg-[#F5EDD8] dark:hover:bg-[#2F2519] transition-colors"
      >
        <SocialIcon name="researchgate" class="w-4 h-4" />
        ResearchGate
      </a>
      <a
        href="/cv/Tasfia_Noor_PHD_Resume.pdf"
        download
        class="flex items-center gap-2 px-5 py-2 rounded-lg bg-golden-500 hover:bg-golden-600 text-sm font-medium text-white transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Download CV
      </a>
    </div>
  </div>
</section>

<!-- Footer -->
<footer className="py-8 px-4 border-t border-[#DFD0B5] dark:border-[#3D3020] bg-[#FEFAE0] dark:bg-[#1A1510]">
  <div className="max-w-6xl mx-auto flex items-center  text-sm text-[#9A7A60] dark:text-[#7A6248]">
    <p class="text-center">&copy {new Date().getFullYear()} Tasfia Noor</p>
  </div>
</footer>
