---
import { experience } from '../data/experience';
---

<section id="experience" class="py-24 px-4 sm:px-6 lg:px-8" aria-labelledby="experience-heading">
  <div class="max-w-4xl mx-auto">
    <div class="mb-12">
      <p class="text-sm font-semibold tracking-widest uppercase text-golden-600 dark:text-golden-400 mb-3" data-animate>
        Work History
      </p>
      <h2
        id="experience-heading"
        class="section-heading text-3xl sm:text-4xl text-[#2C1A0F] dark:text-[#F0EBD8]"
        data-animate data-animate-delay="100"
      >
        Experience
      </h2>
    </div>

    <div class="relative">
      <div class="absolute left-5 top-0 bottom-0 w-px bg-[#DFD0B5] dark:bg-[#3D3020] hidden sm:block" aria-hidden="true"></div>

      <div class="space-y-10">
        {experience.map((job, i) => (
          <div class="relative sm:pl-16" data-animate data-animate-delay={String(i * 150)}>
            <div class="absolute left-0 top-1 hidden sm:flex w-10 h-10 rounded-full bg-golden-500 items-center justify-center shadow-sm" aria-hidden="true">
              {i === 0 ? (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
                </svg>
              ) : (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                </svg>
              )}
            </div>

            <div class="p-6 rounded-2xl border border-[#DFD0B5] dark:border-[#3D3020] bg-[#FEFAE0] dark:bg-[#251E14] hover:border-golden-400 dark:hover:border-golden-700 hover:shadow-md transition-all duration-300">
              <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
                <div>
                  <h3 class="font-semibold text-lg text-[#2C1A0F] dark:text-[#F0EBD8]">{job.role}</h3>
                  <p class="text-golden-600 dark:text-golden-400 font-medium text-sm mt-0.5">{job.organization}</p>
                  {job.department && (
                    <p class="text-[#9A7A60] dark:text-[#7A6248] text-xs mt-0.5 italic">{job.department}</p>
                  )}
                </div>
                <div class="text-right shrink-0">
                  <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-[#F0E8D5] dark:bg-[#2F2519] text-[#7A5E48] dark:text-[#C0A87A]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                    {job.startDate} – {job.endDate === 'Present' ? (
                      <span class="text-golden-600 dark:text-golden-400 font-semibold">Present</span>
                    ) : job.endDate}
                  </div>
                  <p class="text-xs text-[#9A7A60] dark:text-[#7A6248] mt-1">{job.location}</p>
                </div>
              </div>

              <ul class="mt-3 space-y-1.5 text-sm text-[#7A5E48] dark:text-[#C0A87A]">
                {job.description.map(point => (
                  <li class="flex items-start gap-2">
                    <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-golden-400 shrink-0" aria-hidden="true"></span>
                    {point}
                  </li>
                ))}
              </ul>

              {job.tags && job.tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {job.tags.map(tag => (
                    <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-sage-100 dark:bg-sage-950/30 text-sage-700 dark:text-sage-300 border border-sage-200 dark:border-sage-800/40">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
