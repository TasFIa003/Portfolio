---
const interests = [
  {
    icon: 'omics',
    title: 'Multi-omics Integrative Analysis',
    description: 'Microarray, RNA-seq, and single-cell RNA-seq (scRNA-seq) data integration to uncover disease mechanisms across molecular layers.',
  },
  {
    icon: 'network',
    title: 'Biomarker & Key-Gene Discovery',
    description: 'Identification of diagnostic and prognostic biomarkers through differential expression analysis, and protein–protein interaction (PPI) network analysis.',
  },
  {
    icon: 'drug',
    title: 'Drug Repurposing & Vaccine Discovery',
    description: 'Computational pipelines leveraging existing drug databases and multi-omics signatures to identify repurposable therapeutics.',
  },
  {
    icon: 'docking',
    title: 'Molecular Docking & ADMET',
    description: 'Structure-based virtual screening using AutoDock Vina, followed by pharmacokinetic profiling with SwissADME, pkCSM, and ADMETlab.',
  },
  {
    icon: 'ml',
    title: 'Machine Learning for Biological Data',
    description: 'Applying supervised and ensemble ML methods (Random Forest, feature selection) to filter molecular signatures and classify disease states from high-dimensional omics data.',
  },
];
---

<section
  id="research"
  class="py-24 px-4 sm:px-6 lg:px-8 bg-[#FAEDCD] dark:bg-[#1F1912]"
  aria-labelledby="research-heading"
>
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold tracking-widest uppercase text-golden-600 dark:text-golden-400 mb-3" data-animate>
        Focus Areas
      </p>
      <h2
        id="research-heading"
        class="section-heading text-3xl sm:text-4xl text-[#2C1A0F] dark:text-[#F0EBD8]"
        data-animate data-animate-delay="100"
      >
        Research Interests
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {interests.map((item, i) => (
        <div
          class="group p-6 rounded-2xl border border-[#DFD0B5] dark:border-[#3D3020] bg-[#FEFAE0] dark:bg-[#251E14] hover:border-golden-400 dark:hover:border-golden-700 hover:shadow-md transition-all duration-300"
          data-animate
          data-animate-delay={String(Math.min((i + 1) * 100, 500))}
        >
          <div class="mb-4 w-11 h-11 rounded-xl bg-golden-50 dark:bg-golden-950/30 flex items-center justify-center text-golden-600 dark:text-golden-400 group-hover:bg-golden-100 dark:group-hover:bg-golden-950/50 transition-colors">
            {item.icon === 'omics' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h7"/>
              </svg>
            )}
            {item.icon === 'network' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="2"/><circle cx="5" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/>
                <path stroke-linecap="round" d="M7 7l3.5 3.5M16.5 7.5L13 11M7 17l3.5-3.5M13 13l3.5 3.5"/>
              </svg>
            )}
            {item.icon === 'drug' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
              </svg>
            )}
            {item.icon === 'docking' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"/>
              </svg>
            )}
            {item.icon === 'ml' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2h-2"/>
              </svg>
            )}
          </div>
          <h3 class="font-semibold text-[#2C1A0F] dark:text-[#F0EBD8] mb-2 leading-snug">{item.title}</h3>
          <p class="text-sm text-[#7A5E48] dark:text-[#C0A87A] leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
